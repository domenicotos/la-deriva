---
import "../styles/style.css";
import { getCollection } from "astro:content";
import { getSearchArticles } from "../data/search";

const articles = (await getCollection("articles")).sort(
  (a, b) => b.data.number - a.data.number
);

const searchArticles = await getSearchArticles();
console.log(searchArticles);
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
      <title>La Deriva — Domenico Toscano</title>

<meta
  name="description"
  content="Poesie, racconti, recensioni e riflessioni di Domenico Toscano."
/>

<link rel="canonical" href="https://la-deriva.domenicotoscano-site.workers.dev/" />
<meta property="og:type" content="website" />
<meta property="og:title" content="La Deriva — Domenico Toscano" />
<meta
  property="og:description"
  content="Poesie, racconti, recensioni e riflessioni di Domenico Toscano."
/>
<meta
  property="og:url"
  content="https://la-deriva.domenicotoscano-site.workers.dev/"
/>

<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content="La Deriva — Domenico Toscano" />
<meta
  name="twitter:description"
  content="Poesie, racconti, recensioni e riflessioni di Domenico Toscano."
/>
  </head>

  <body>
    <header class="site-header">
      <a href="/" class="logo" aria-label="La Deriva, home">
        <span class="wave" aria-hidden="true">〰</span>
        <span>La Deriva</span>
      </a>

      <nav>
        <a href="#indice">Indice</a>
        <button id="search-toggle" type="button">Cerca</button>
        <a href="#chi-sono">Chi sono</a>
      </nav>
    </header>

    <div class="search-panel" id="search-panel" aria-hidden="true">
  <div class="search-inner">
    <label for="search-input">Cerca negli articoli</label>

    <div class="search-field">
      <input
        id="search-input"
        type="search"
        placeholder="Scrivi per cercare..."
        autocomplete="off"
      />

      <button id="search-close" type="button" aria-label="Chiudi ricerca">
        ×
      </button>
    </div>

    <div class="search-results" id="search-results"></div>
  </div>
</div>
<script type="application/json" id="search-data" set:html={JSON.stringify(searchArticles)}></script>

    <main>
      <section class="intro">
        <p class="eyebrow">Domenico Toscano</p>

        <h1>
          Poesie, racconti,<br />
          recensioni e riflessioni.
        </h1>

        <p class="intro-text">
          Pensieri che arrivano come un lampo e che, se non li appunti subito,
          se ne vanno per sempre.
        </p>
      </section>

      <section class="index" id="indice">
        <div class="section-heading">
          <span>Indice</span>
          <span>{articles.length.toString().padStart(2, "0")}</span>
        </div>

        <div class="articles" id="articles">
  {
    articles.map((article) => (
      <article
        class="article"
        data-search={`${article.data.title} ${article.data.subtitle ?? ""} ${article.data.description}`}
      >
        <div class="article-number">
          {article.data.number.toString().padStart(2, "0")}
        </div>

        <div class="article-content">
          <h2>
            <a href={`/${article.data.number}`}>
              {article.data.title}
            </a>
          </h2>

          {article.data.subtitle && (
            <p class="subtitle">{article.data.subtitle}</p>
          )}

          <div class="article-meta">
  {article.data.date.toLocaleDateString("it-IT", {
    day: "2-digit",
    month: "long",
    year: "numeric",
  })}
</div>
{article.data.type !== "articolo" && (
  <div class="article-type">
    {article.data.type}
  </div>
)}

          <div class="article-formats" aria-label="Formati disponibili">
            {article.data.formats.includes("video") && (
              <svg
                class="format-icon"
                viewBox="0 0 24 24"
                aria-label="Video"
                role="img"
              >
                <rect
                  x="3"
                  y="5"
                  width="13"
                  height="14"
                  rx="2"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <path
                  d="M16 10l5-3v10l-5-3z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                />
              </svg>
            )}

            {article.data.formats.includes("podcast") && (
              <svg
                class="format-icon"
                viewBox="0 0 24 24"
                aria-label="Podcast"
                role="img"
              >
                <rect
                  x="9"
                  y="3"
                  width="6"
                  height="11"
                  rx="3"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <path
                  d="M6 11a6 6 0 0 0 12 0M12 17v4M9 21h6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
              </svg>
            )}
          </div>

          <p class="excerpt">{article.data.description}</p>
        </div>

        <div class="arrow">↗</div>
      </article>
    ))
  }
</div>

        <p class="no-results" id="no-results">
          Nessun articolo trovato.
        </p>
      </section>

      <section class="about" id="chi-sono">
        <div class="section-heading">
          <span>Chi sono</span>
        </div>

        <p>
          Sono Domenico. Scrivo poesie, racconti brevi e riflessioni sulle cose che spesso non sappiamo dire. Recensioni di libri e di film, ma molto sporadiche. Pensieri che arrivano come un lampo e che, se non li appunti subito, se ne vanno per sempre.
        </p>
      </section>
    </main>

    <footer>
      <span>La Deriva</span>
      <span>© {new Date().getFullYear()} Domenico Toscano</span>
    </footer>
  </body>
</html>

 <script>
  document.addEventListener("DOMContentLoaded", () => {
    const searchToggle = document.querySelector("#search-toggle");
    const searchPanel = document.querySelector("#search-panel");
    const searchInput = document.querySelector("#search-input");
    const searchClose = document.querySelector("#search-close");
    const searchResults = document.querySelector("#search-results");
    const searchData = document.querySelector("#search-data");

    let articles = [];

    if (searchData) {
      try {
        articles = JSON.parse(searchData.textContent || "[]");
      } catch (error) {
        console.error("Errore nei dati della ricerca:", error);
      }
    }

    function renderResults(query) {
      if (!searchResults) return;

      const normalizedQuery = query.trim().toLowerCase();

      if (!normalizedQuery) {
        searchResults.innerHTML = "";
        return;
      }

      const matches = articles.filter((article) => {
        const searchableText = [
          article.title || "",
          article.subtitle || "",
          article.description || "",
        ]
          .join(" ")
          .toLowerCase();

        return searchableText.includes(normalizedQuery);
      });

      if (matches.length === 0) {
        searchResults.innerHTML = `
          <div class="search-no-results">
            Nessun articolo trovato.
          </div>
        `;
        return;
      }

      searchResults.innerHTML = matches
        .map((article) => {
          const number = String(article.number).padStart(2, "0");

          const type =
            article.type && article.type !== "articolo"
              ? `<span class="search-result-type">${article.type}</span>`
              : "";

          const formats = Array.isArray(article.formats)
            ? article.formats
            : [];

          const videoIcon = formats.includes("video")
            ? `
              <svg class="search-format-icon" viewBox="0 0 24 24" aria-hidden="true">
                <rect
                  x="3"
                  y="5"
                  width="13"
                  height="14"
                  rx="2"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <path
                  d="M16 10l5-3v10l-5-3z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                />
              </svg>
            `
            : "";

          const podcastIcon = formats.includes("podcast")
            ? `
              <svg class="search-format-icon" viewBox="0 0 24 24" aria-hidden="true">
                <rect
                  x="9"
                  y="3"
                  width="6"
                  height="11"
                  rx="3"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <path
                  d="M6 11a6 6 0 0 0 12 0M12 17v4M9 21h6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
              </svg>
            `
            : "";

          return `
            <a class="search-result" href="${article.url}">
              <span class="search-result-number">${number}</span>

              <span class="search-result-title">
                ${article.title}
              </span>

              <span class="search-result-meta">
                ${videoIcon}
                ${podcastIcon}
                ${type}
              </span>
            </a>
          `;
        })
        .join("");
    }

    searchToggle?.addEventListener("click", () => {
      searchPanel?.classList.add("open");
      searchPanel?.setAttribute("aria-hidden", "false");

      setTimeout(() => {
        searchInput?.focus();
      }, 50);
    });

    searchClose?.addEventListener("click", () => {
      searchPanel?.classList.remove("open");
      searchPanel?.setAttribute("aria-hidden", "true");

      if (searchInput instanceof HTMLInputElement) {
        searchInput.value = "";
      }

      if (searchResults) {
        searchResults.innerHTML = "";
      }
    });

    searchInput?.addEventListener("input", () => {
      if (searchInput instanceof HTMLInputElement) {
        renderResults(searchInput.value);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        searchClose?.click();
      }
    });
  });
</script>

<style>
  main {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .intro {
    max-width: 760px;
    padding: 110px 0 125px;
  }
  

  .eyebrow {
    margin: 0 0 25px;
    color: #2678a5;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  h1 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(44px, 6vw, 78px);
    line-height: 0.98;
    font-weight: 400;
    letter-spacing: -0.055em;
  }

  .intro-text {
    max-width: 540px;
    margin: 35px 0 0;
    color: #686b70;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 19px;
    line-height: 1.6;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    padding: 0 0 17px;
    border-bottom: 2px solid #17191c;
    color: #686b70;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .articles {
    border-bottom: 1px solid #d9d9d4;
  }

  .article {
    display: grid;
    grid-template-columns: 70px minmax(0, 1fr) 35px;
    gap: 20px;
    padding: 43px 0 48px;
    border-bottom: 1px solid #d9d9d4;
  }

  .article:last-child {
    border-bottom: 0;
  }

  .article.hidden {
    display: none;
  }

  .article-number {
    color: #2678a5;
    font-size: 13px;
    font-weight: 600;
    padding-top: 6px;
  }

  .article-content {
    max-width: 760px;
  }

  .article-content h2 a {
    color: inherit;
    text-decoration: none;
  }

  .article-content h2 a:hover {
    color: #1677b8;
  }

  h1 {
  margin: 0;
  font-family: "Roboto Condensed", Arial, Helvetica, sans-serif;
  font-size: clamp(38px, 5vw, 64px);
  }

  h2 {
    margin: 0;
  font-family: "Roboto Condensed", Arial, Helvetica, sans-serif;
  font-size: clamp(25px, 3.2vw, 40px);
    line-height: 1.03;
    font-weight: 400;
    letter-spacing: -0.045em;
  }

  .subtitle {
    max-width: 650px;
    margin: 13px 0 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 20px;
    line-height: 1.4;
    color: #4e5257;
  }

  .article-meta {
    margin-top: 19px;
    color: #777b80;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .excerpt {
    max-width: 650px;
    margin: 23px 0 0;
    color: #5d6268;
    font-size: 16px;
    line-height: 1.65;
  }

  .arrow {
    padding-top: 4px;
    color: #2678a5;
    font-size: 22px;
    text-align: right;
  }

  .no-results {
    display: none;
    margin: 30px 0 0;
    color: #777b80;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 20px;
  }

  .no-results.visible {
    display: block;
  }

  .about {
    max-width: 760px;
    padding: 110px 0;
  }

  .about p {
    margin: 30px 0 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 26px;
    line-height: 1.45;
    letter-spacing: -0.02em;
  }

  @media (max-width: 700px) {
    main {
      width: min(100% - 32px, 1180px);
    }

    .intro {
      padding: 75px 0 85px;
    }

    h1 {
      font-size: 48px;
    }

    .article {
      grid-template-columns: 38px minmax(0, 1fr);
      gap: 10px;
      padding: 35px 0 40px;
    }

    .arrow {
      display: none;
    }

    h2 {
      font-size: 34px;
    }

    .subtitle {
      font-size: 18px;
    }

    .about {
      padding: 80px 0;
    }

    .about p {
      font-size: 22px;
    }
  }
</style>