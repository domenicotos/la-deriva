---
import "../styles/style.css";
import { getCollection, render } from "astro:content";
import { getSearchArticles } from "../data/search";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  const searchArticles = await getSearchArticles();

  return articles.map((article) => ({
    params: {
      number: String(article.data.number),
    },
    props: {
      article,
    },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const searchArticles = await getSearchArticles();

const articles = (await getCollection("articles")).sort(
  (a, b) => a.data.number - b.data.number
);

const currentIndex = articles.findIndex(
  (item) => item.data.number === article.data.number
);

const previous = articles[currentIndex - 1];
const next = articles[currentIndex + 1];
---

<!doctype html>
<html lang="it">
  <head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />

  <title>{article.data.title} — La Deriva</title>

  <meta name="description" content={article.data.description} />

  <link
    rel="canonical"
    href={`https://la-deriva.domenicotoscano-site.workers.dev/${article.data.number}`}
  />

  <meta property="og:type" content="article" />
  <meta property="og:title" content={`${article.data.title} — La Deriva`} />
  <meta property="og:description" content={article.data.description} />
  <meta
    property="og:url"
    content={`https://la-deriva.domenicotoscano-site.workers.dev/${article.data.number}`}
  />

  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={`${article.data.title} — La Deriva`} />
  <meta name="twitter:description" content={article.data.description} />
  <script>
const copyButton = document.querySelector("#copy-button");
const shareMessage = document.querySelector("#share-message");

const pageUrl = window.location.href;
const pageTitle = document.title;

const whatsapp = document.querySelector("#share-whatsapp");
const telegram = document.querySelector("#share-telegram");
const email = document.querySelector("#share-email");

if (whatsapp) {
  whatsapp.href = `https://wa.me/?text=${encodeURIComponent(
    `${pageTitle} ${pageUrl}`
  )}`;
}

if (telegram) {
  telegram.href = `https://t.me/share/url?url=${encodeURIComponent(
    pageUrl
  )}&text=${encodeURIComponent(pageTitle)}`;
}

if (email) {
  email.href = `mailto:?subject=${encodeURIComponent(
    pageTitle
  )}&body=${encodeURIComponent(pageUrl)}`;
}

copyButton?.addEventListener("click", async () => {
  try {
    await navigator.clipboard.writeText(pageUrl);

    if (shareMessage) {
      shareMessage.textContent = "Link copiato.";
      
      setTimeout(() => {
        shareMessage.textContent = "";
      }, 2000);
    }
  } catch {
    if (shareMessage) {
      shareMessage.textContent = "Impossibile copiare il link.";
    }
  }
});
</script>
</head>

<body>
  <a id="top"></a>
    <header class="site-header">
  <a href="/" class="logo" aria-label="La Deriva, home">
    <span class="wave" aria-hidden="true">〰</span>
    <span>La Deriva</span>
  </a>

  <nav>
    <a href="/">Indice</a>
    <button id="search-toggle" type="button">Cerca</button>
    <a href="/#chi-sono">Chi sono</a>
  </nav>
</header>

<div class="search-panel" id="search-panel" aria-hidden="true">
  <div class="search-inner">
    <label for="search-input">Cerca negli articoli</label>

    <div class="search-field">
      <input
        id="search-input"
        type="search"
        placeholder="Scrivi per cercare..."
        autocomplete="off"
      />

      <button id="search-close" type="button" aria-label="Chiudi ricerca">
        ×
      </button>
    </div>

    <div class="search-results" id="search-results"></div>
  </div>
</div>
<script type="application/json" id="search-data" set:html={JSON.stringify(searchArticles)}></script>

    <main>
      <article>
        <div class="article-number">
  {article.data.number.toString().padStart(2, "0")} / LA DERIVA
</div>

        <h1>{article.data.title}</h1>

        {
          article.data.subtitle && (
            <p class="subtitle">{article.data.subtitle}</p>
          )
        }

        <div class="date">
          {article.data.date.toLocaleDateString("it-IT", {
            day: "numeric",
            month: "long",
            year: "numeric",
          })}
        </div>
        {article.data.type !== "articolo" && (
  <div class="article-type">
    {article.data.type}
  </div>
)}

        <div class="content">
          <Content />
        </div>
      </article>
     <div class="share">
  <span class="share-label">Condividi</span>

  <div class="share-actions">

    <a
      id="share-whatsapp"
      class="share-icon"
      href="#"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Condividi su WhatsApp"
      title="WhatsApp"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M20.5 3.5A11.9 11.9 0 0 0 12.05 0C5.48 0 0.13 5.35 0.13 11.92c0 2.1.55 4.15 1.59 5.96L0 24l6.26-1.64a11.9 11.9 0 0 0 5.79 1.49h.01c6.57 0 11.92-5.35 11.92-11.92 0-3.18-1.24-6.17-3.48-8.43ZM12.06 21.8h-.01a9.86 9.86 0 0 1-5.03-1.38l-.36-.21-3.71.97.99-3.61-.23-.37a9.87 9.87 0 1 1 8.35 4.6Zm5.42-7.4c-.3-.15-1.78-.88-2.05-.98-.28-.1-.47-.15-.67.15-.2.3-.77.98-.94 1.18-.17.2-.35.22-.65.07-.3-.15-1.24-.46-2.36-1.46-.87-.78-1.46-1.74-1.63-2.04-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.5s1.07 2.9 1.22 3.1c.15.2 2.1 3.2 5.1 4.49.71.31 1.26.49 1.69.63.71.23 1.35.2 1.86.12.57-.08 1.78-.73 2.03-1.43.25-.7.25-1.3.17-1.43-.07-.12-.27-.2-.57-.35Z"
          fill="currentColor"
        />
      </svg>
    </a>

    <a
      id="share-telegram"
      class="share-icon"
      href="#"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Condividi su Telegram"
      title="Telegram"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M21.8 3.2 18.4 20c-.25 1.18-.91 1.47-1.85.92l-5.08-3.74-2.45 2.36c-.27.27-.5.5-1.02.5l.36-5.17 9.41-8.5c.41-.36-.09-.56-.64-.2L5.5 13.38.47 11.8c-1.09-.34-1.11-1.09.23-1.59L20.34 2.6c.9-.33 1.68.22 1.46.6Z"
          fill="currentColor"
        />
      </svg>
    </a>

    <a
      id="share-email"
      class="share-icon"
      href="#"
      aria-label="Condividi via email"
      title="Email"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect
          x="2.5"
          y="4.5"
          width="19"
          height="15"
          rx="2"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
        />
        <path
          d="m3.5 6 8.5 7 8.5-7"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linejoin="round"
        />
      </svg>
    </a>

    <button
      id="copy-button"
      class="share-icon"
      type="button"
      aria-label="Copia link"
      title="Copia link"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect
          x="8"
          y="8"
          width="11"
          height="12"
          rx="2"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
        />
        <path
          d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h2"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
        />
      </svg>
    </button>

    <span id="share-message" class="share-message" aria-live="polite"></span>
  </div>
</div>

      <nav class="article-navigation" aria-label="Navigazione articoli">
        {
          previous ? (
            <a href={`/${previous.data.number}`}>
              <span>← Precedente</span>
              <strong>{previous.data.title}</strong>
            </a>
          ) : (
            <span></span>
          )
        }

        {
          next && (
            <a class="next" href={`/${next.data.number}`}>
              <span>Successivo →</span>
              <strong>{next.data.title}</strong>
            </a>
          )
        }
      </nav>
    </main>

    <footer>
  <span>La Deriva © 2026 Domenico Toscano</span>

  <div class="footer-socials">
    <a
      href="https://instagram.com/domenicotos"
      target="_blank"
      rel="noopener noreferrer"
    >
      Instagram
    </a>

    <a
      href="https://tiktok.com/@norvk1"
      target="_blank"
      rel="noopener noreferrer"
    >
      TikTok
    </a>

    <a
      href="https://domenicotoscano.substack.com"
      target="_blank"
      rel="noopener noreferrer"
    >
      Substack
    </a>

    <a
      href="https://youtube.com/@domenico.toscano"
      target="_blank"
      rel="noopener noreferrer"
    >
      YouTube
    </a>
  </div>
</footer>
   <script>
  document.addEventListener("DOMContentLoaded", () => {
    const searchToggle = document.querySelector("#search-toggle");
    const searchPanel = document.querySelector("#search-panel");
    const searchInput = document.querySelector("#search-input");
    const searchClose = document.querySelector("#search-close");
    const searchResults = document.querySelector("#search-results");
    const searchData = document.querySelector("#search-data");

    let articles = [];

    if (searchData) {
      try {
        articles = JSON.parse(searchData.textContent || "[]");
      } catch (error) {
        console.error("Errore nei dati della ricerca:", error);
      }
    }

    function renderResults(query) {
      if (!searchResults) return;

      const normalizedQuery = query.trim().toLowerCase();

      if (!normalizedQuery) {
        searchResults.innerHTML = "";
        return;
      }

      const matches = articles.filter((article) => {
        const searchableText = [
          article.title || "",
          article.subtitle || "",
          article.description || "",
        ]
          .join(" ")
          .toLowerCase();

        return searchableText.includes(normalizedQuery);
      });

      if (matches.length === 0) {
        searchResults.innerHTML = `
          <div class="search-no-results">
            Nessun articolo trovato.
          </div>
        `;
        return;
      }

      searchResults.innerHTML = matches
        .map((article) => {
          const number = String(article.number).padStart(2, "0");

          const type =
            article.type && article.type !== "articolo"
              ? `<span class="search-result-type">${article.type}</span>`
              : "";

          const formats = Array.isArray(article.formats)
            ? article.formats
            : [];

          const videoIcon = formats.includes("video")
            ? `
              <svg class="search-format-icon" viewBox="0 0 24 24" aria-hidden="true">
                <rect
                  x="3"
                  y="5"
                  width="13"
                  height="14"
                  rx="2"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <path
                  d="M16 10l5-3v10l-5-3z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                />
              </svg>
            `
            : "";

          const podcastIcon = formats.includes("podcast")
            ? `
              <svg class="search-format-icon" viewBox="0 0 24 24" aria-hidden="true">
                <rect
                  x="9"
                  y="3"
                  width="6"
                  height="11"
                  rx="3"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <path
                  d="M6 11a6 6 0 0 0 12 0M12 17v4M9 21h6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
              </svg>
            `
            : "";

          return `
            <a class="search-result" href="${article.url}">
              <span class="search-result-number">${number}</span>

              <span class="search-result-title">
                ${article.title}
              </span>

              <span class="search-result-meta">
                ${videoIcon}
                ${podcastIcon}
                ${type}
              </span>
            </a>
          `;
        })
        .join("");
    }

    searchToggle?.addEventListener("click", () => {
      searchPanel?.classList.add("open");
      searchPanel?.setAttribute("aria-hidden", "false");

      setTimeout(() => {
        searchInput?.focus();
      }, 50);
    });

    searchClose?.addEventListener("click", () => {
      searchPanel?.classList.remove("open");
      searchPanel?.setAttribute("aria-hidden", "true");

      if (searchInput instanceof HTMLInputElement) {
        searchInput.value = "";
      }

      if (searchResults) {
        searchResults.innerHTML = "";
      }
    });

    searchInput?.addEventListener("input", () => {
      if (searchInput instanceof HTMLInputElement) {
        renderResults(searchInput.value);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        searchClose?.click();
      }
    });
  });
</script>
  </body>
</html>

<style>
  main {
    max-width: 760px;
    margin: 0 auto;
    padding: 80px 24px 100px;
  }

  article {
    border-top: 1px solid #d9d9d4;
    padding-top: 28px;
  }

  .content :global(img) {
  display: block;
  width: 100%;
  max-width: 100%;
  height: auto;
  margin: 45px 0;
  box-shadow: 2px 3px 6px rgba(0, 0, 0, 0.07);
}

  .content :global(mark) {
    background: #dcecff;
    color: inherit;
    padding: 0.05em 0.15em;
  }

  .content :global(.blu) {
    color: #3b6ea8;
  }

  .content :global(details) {
    margin: 40px 0;
    border-top: 1px solid #d8d8d8;
    border-bottom: 1px solid #d8d8d8;
    padding: 18px 0;
  }

  .content :global(summary) {
    cursor: pointer;
    color: #3b6ea8;
    font-family: Arial, sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .content :global(details[open] summary) {
    margin-bottom: 24px;
  }

  .article-number {
    margin-bottom: 24px;
    color: #1677b8;
    font-family: Arial, sans-serif;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    margin: 0;
    max-width: 700px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.06;
    font-weight: 400;
    letter-spacing: -0.045em;
  }

  .subtitle {
    margin: 24px 0 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.3rem;
    line-height: 1.5;
    color: #555;
  }

  .date {
    margin-top: 24px;
    color: #777;
    font-family: Arial, sans-serif;
    font-size: 0.82rem;
  }

  .content {
    max-width: 680px;
    margin-top: 64px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.12rem;
    line-height: 1.85;
  }

  .content :global(h2) {
    margin-top: 2.5em;
    font-size: 1.8rem;
    line-height: 1.2;
  }

  .content :global(p) {
    margin: 1.4em 0;
  }

  .content :global(a) {
    color: #1677b8;
  }

  .article-type {
    margin-top: 12px;
    color: #2678a5;
    font-family: Arial, sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .article-navigation {
    max-width: 680px;
    margin: 110px auto 0;
    padding-top: 24px;
    border-top: 1px solid #d9d9d4;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    font-family: Arial, sans-serif;
  }

  .article-navigation a {
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: inherit;
    text-decoration: none;
  }

  .article-navigation a:hover strong {
    color: #1677b8;
  }

  .article-navigation span {
    color: #777;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .article-navigation strong {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.05rem;
    font-weight: 400;
  }

  .share {
    margin-top: 70px;
    padding-top: 25px;
    border-top: 1px solid #d9d9d4;
  }

  .share-label {
    display: block;
    margin-bottom: 15px;
    color: #777b80;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .share-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .share-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    background: transparent;
    color: #2678a5;
    cursor: pointer;
    text-decoration: none;
  }

  .share-icon svg {
    width: 20px;
    height: 20px;
  }

  .share-icon:hover {
    color: #17191c;
  }

  .share-message {
    margin-left: 4px;
    color: #777b80;
    font-size: 12px;
  }

  .next {
    text-align: right;
  }

  footer {
    max-width: 900px;
    margin: 0 auto;
    padding: 30px 24px 50px;
    border-top: 1px solid #d9d9d4;
    font-family: Arial, sans-serif;
  }

  @media (max-width: 700px) {
    main {
      padding: 50px 18px 70px;
    }

    .article-navigation {
      grid-template-columns: 1fr;
    }

    .next {
      text-align: left;
    }
  }
</style>