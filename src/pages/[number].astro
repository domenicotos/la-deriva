---
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const articles = await getCollection("articles");

  return articles.map((article) => ({
    params: {
      number: String(article.data.number),
    },
    props: {
      article,
    },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const articles = (await getCollection("articles")).sort(
  (a, b) => a.data.number - b.data.number
);

const currentIndex = articles.findIndex(
  (item) => item.data.number === article.data.number
);

const previous = articles[currentIndex - 1];
const next = articles[currentIndex + 1];
---

<!doctype html>
<html lang="it">
  <head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />

  <title>{article.data.title} — La Deriva</title>

  <meta name="description" content={article.data.description} />

  <link
    rel="canonical"
    href={`https://la-deriva.domenicotoscano-site.workers.dev/${article.data.number}`}
  />

  <meta property="og:type" content="article" />
  <meta property="og:title" content={`${article.data.title} — La Deriva`} />
  <meta property="og:description" content={article.data.description} />
  <meta
    property="og:url"
    content={`https://la-deriva.domenicotoscano-site.workers.dev/${article.data.number}`}
  />

  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={`${article.data.title} — La Deriva`} />
  <meta name="twitter:description" content={article.data.description} />
  <script>
const copyButton = document.querySelector("#copy-button");
const shareMessage = document.querySelector("#share-message");

const pageUrl = window.location.href;
const pageTitle = document.title;

const whatsapp = document.querySelector("#share-whatsapp");
const telegram = document.querySelector("#share-telegram");
const email = document.querySelector("#share-email");

if (whatsapp) {
  whatsapp.href = `https://wa.me/?text=${encodeURIComponent(
    `${pageTitle} ${pageUrl}`
  )}`;
}

if (telegram) {
  telegram.href = `https://t.me/share/url?url=${encodeURIComponent(
    pageUrl
  )}&text=${encodeURIComponent(pageTitle)}`;
}

if (email) {
  email.href = `mailto:?subject=${encodeURIComponent(
    pageTitle
  )}&body=${encodeURIComponent(pageUrl)}`;
}

copyButton?.addEventListener("click", async () => {
  try {
    await navigator.clipboard.writeText(pageUrl);

    if (shareMessage) {
      shareMessage.textContent = "Link copiato.";
      
      setTimeout(() => {
        shareMessage.textContent = "";
      }, 2000);
    }
  } catch {
    if (shareMessage) {
      shareMessage.textContent = "Impossibile copiare il link.";
    }
  }
});
</script>
</head>

<body>
  <a id="top"></a>
    <header class="site-header">
      <a class="brand" href="/">
        <span class="mark">〰</span>
        <span>La Deriva</span>
      </a>

      <nav>
        <a href="/">Indice</a>
        <a href="/#chi-sono">Chi sono</a>
      </nav>
    </header>

    <main>
      <article>
        <div class="article-number">
  {article.data.number.toString().padStart(2, "0")} / LA DERIVA
</div>

        <h1>{article.data.title}</h1>

        {
          article.data.subtitle && (
            <p class="subtitle">{article.data.subtitle}</p>
          )
        }

        <div class="date">
          {article.data.date.toLocaleDateString("it-IT", {
            day: "numeric",
            month: "long",
            year: "numeric",
          })}
        </div>

        <div class="content">
          <Content />
        </div>
      </article>
     <div class="share">
  <span class="share-label">Condividi</span>

  <div class="share-actions">

    <a
      id="share-whatsapp"
      class="share-icon"
      href="#"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Condividi su WhatsApp"
      title="WhatsApp"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M20.5 3.5A11.9 11.9 0 0 0 12.05 0C5.48 0 0.13 5.35 0.13 11.92c0 2.1.55 4.15 1.59 5.96L0 24l6.26-1.64a11.9 11.9 0 0 0 5.79 1.49h.01c6.57 0 11.92-5.35 11.92-11.92 0-3.18-1.24-6.17-3.48-8.43ZM12.06 21.8h-.01a9.86 9.86 0 0 1-5.03-1.38l-.36-.21-3.71.97.99-3.61-.23-.37a9.87 9.87 0 1 1 8.35 4.6Zm5.42-7.4c-.3-.15-1.78-.88-2.05-.98-.28-.1-.47-.15-.67.15-.2.3-.77.98-.94 1.18-.17.2-.35.22-.65.07-.3-.15-1.24-.46-2.36-1.46-.87-.78-1.46-1.74-1.63-2.04-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.5s1.07 2.9 1.22 3.1c.15.2 2.1 3.2 5.1 4.49.71.31 1.26.49 1.69.63.71.23 1.35.2 1.86.12.57-.08 1.78-.73 2.03-1.43.25-.7.25-1.3.17-1.43-.07-.12-.27-.2-.57-.35Z"
          fill="currentColor"
        />
      </svg>
    </a>

    <a
      id="share-telegram"
      class="share-icon"
      href="#"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Condividi su Telegram"
      title="Telegram"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M21.8 3.2 18.4 20c-.25 1.18-.91 1.47-1.85.92l-5.08-3.74-2.45 2.36c-.27.27-.5.5-1.02.5l.36-5.17 9.41-8.5c.41-.36-.09-.56-.64-.2L5.5 13.38.47 11.8c-1.09-.34-1.11-1.09.23-1.59L20.34 2.6c.9-.33 1.68.22 1.46.6Z"
          fill="currentColor"
        />
      </svg>
    </a>

    <a
      id="share-email"
      class="share-icon"
      href="#"
      aria-label="Condividi via email"
      title="Email"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect
          x="2.5"
          y="4.5"
          width="19"
          height="15"
          rx="2"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
        />
        <path
          d="m3.5 6 8.5 7 8.5-7"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linejoin="round"
        />
      </svg>
    </a>

    <button
      id="copy-button"
      class="share-icon"
      type="button"
      aria-label="Copia link"
      title="Copia link"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect
          x="8"
          y="8"
          width="11"
          height="12"
          rx="2"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
        />
        <path
          d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h2"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
        />
      </svg>
    </button>

    <span id="share-message" class="share-message" aria-live="polite"></span>
  </div>
</div>

      <nav class="article-navigation" aria-label="Navigazione articoli">
        {
          previous ? (
            <a href={`/${previous.data.number}`}>
              <span>← Precedente</span>
              <strong>{previous.data.title}</strong>
            </a>
          ) : (
            <span></span>
          )
        }

        {
          next && (
            <a class="next" href={`/${next.data.number}`}>
              <span>Successivo →</span>
              <strong>{next.data.title}</strong>
            </a>
          )
        }
      </nav>
    </main>

    <footer>
      <a href="/">La Deriva</a>
    </footer>
  </body>
</html>

<style>
